{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/birthdays",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/reconcile",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/proxy/:route(me|action|redeem)",
      "destination": "/api/:route"
    }
  ]
}
